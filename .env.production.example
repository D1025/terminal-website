# Public addresses
SITE_DOMAIN=fonline-nd.com
UPDATER_DOMAIN=updater.fonline-nd.com
STORAGE_DOMAIN=storage.fonline-nd.com
PUBLIC_BASE_URL=https://fonline-nd.com
ALLOWED_ORIGINS=https://fonline-nd.com
S3_PUBLIC_ENDPOINT=https://storage.fonline-nd.com
ACME_EMAIL=admin@fonline-nd.com

# PostgreSQL
DATABASE_NAME=newdawn
DATABASE_USER=newdawn
DATABASE_PASSWORD=replace-with-a-long-random-password

# Authentication
JWT_SECRET=replace-with-at-least-64-random-characters
JWT_ISSUER=https://fonline-nd.com
JWT_AUDIENCE=new-dawn-api
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-strong-unique-password

# Private MinIO bucket
MINIO_ROOT_USER=replace-with-a-separate-random-root-user
MINIO_ROOT_PASSWORD=replace-with-a-strong-random-root-password
S3_ACCESS_KEY=replace-with-a-random-access-key
S3_SECRET_KEY=replace-with-a-strong-random-secret-of-at-least-16-characters
S3_BUCKET=new-dawn

# Local infrastructure backups. Use an absolute path on the Droplet.
BACKUP_DIRECTORY=/var/lib/new-dawn/backups
BACKUP_INTERVAL_SECONDS=86400
BACKUP_RETENTION_DAYS=7
BACKUP_MAX_AGE_SECONDS=129600

# Disk monitoring. A Discord webhook is optional; without it an alert is still
# written to Docker logs and the storage-monitor container becomes unhealthy.
DISK_ALERT_PERCENT=80
DISK_CHECK_INTERVAL_SECONDS=300
DISK_ALERT_WEBHOOK_URL=

# The legacy TCP updater is disabled by default. To migrate old clients, set
# this to true and start Compose with --profile legacy.
LEGACY_UPDATER_ENABLED=false
LEGACY_UPDATER_CHANNEL=STABLE
LEGACY_UPDATER_GAME_FILE_NAME=FOnline
LEGACY_UPDATER_NEWS_URL=https://fonline-nd.com

BACKUP_MAX_FILE_SIZE=2GB
TZ=Europe/Warsaw
